{
  "name": "cocomusic",
  "productName": "CoCo Music",
  "version": "0.0.5",
  "private": true,
  "description": "CoCo Music 多平台音乐桌面播放器",
  "author": "markcxx",
  "homepage": "https://github.com/markcxx/cocomusic",
  "license": "GPL-3.0-only",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "predev": "node scripts/ensure-deps.mjs && npm run build:electron",
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --port 3457 --hostname 127.0.0.1",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:next": "next build && node scripts/prepare-standalone.mjs",
    "prebuild": "node scripts/ensure-deps.mjs",
    "build": "npm run build:electron && npm run build:next",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "lint": "eslint",
    "preview:menus": "node --experimental-strip-types --no-warnings scripts/preview-system-menus.mjs",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "node --import tsx --no-warnings --test \"src/**/*.test.ts\" \"electron/**/*.test.ts\"",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "framer-motion": "12.26.2",
    "lucide-react": "0.562.0",
    "music-metadata": "12.2.3",
    "next": "16.1.2",
    "node-taglib-sharp": "6.0.3",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@types/react-test-renderer": "19.1.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.1.2",
    "react-test-renderer": "19.2.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "node-taglib-sharp": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  }
}
